# Copie para .env e preencha.
# Chave da Maps JavaScript API (console.cloud.google.com > APIs e serviços > Credenciais)
GOOGLE_MAPS_API_KEY=
# Map ID (opcional). Vazio usa DEMO_MAP_ID, que serve para desenvolvimento.
GOOGLE_MAPS_MAP_ID=
# Máximo de vértices do polígono enviado ao Citeleat
MAX_VERTICES=1000
